  "lessons": [
    {
      "id": "saludos",
      "order": 1,
      "title": "Saludos",
      "subtitle": "Greetings, politeness, and small talk",
      "sections": [
        {
          "type": "words",
          "title": "The essentials",
          "note": "Every Spanish conversation opens with one of these.",
          "wordIds": ["hola", "buenos-dias", "buenas-tardes", "buenas-noches", "adios", "gracias", "por-favor", "de-nada"]
        },
        {
          "type": "words",
          "title": "Small talk",
          "note": "Watch the punctuation — questions start with ¿ and end with ?",
          "wordIds": ["como-estas", "bien", "mal", "si", "no", "que-tal", "por-que", "lo-siento"]
        },
        {
          "type": "text",
          "title": "Put it together",
          "body": "Say hello, ask how someone is, then thank them and say goodbye:\n\n— ¡Hola! ¿Cómo estás?\n— Bien, gracias. ¿Y tú?\n— Muy bien, hasta luego.\n\nNote that 'hasta luego' literally means 'until later' and works as a casual goodbye."
        }
      ],
      "quiz": {
        "id": "saludos-quiz",
        "title": "Saludos quiz",
        "passThreshold": 0.75,
        "questions": [
          {
            "type": "choice",
            "prompt": "How do you say 'good morning'?",
            "options": [
              { "value": "buenos días", "correct": true },
              { "value": "buenas noches", "correct": false },
              { "value": "buenas tardes", "correct": false },
              { "value": "hasta luego", "correct": false }
            ]
          },
          {
            "type": "choice",
            "prompt": "What does 'de nada' literally mean?",
            "options": [
              { "value": "of nothing", "correct": true },
              { "value": "for nothing", "correct": false },
              { "value": "from the town", "correct": false },
              { "value": "of the morning", "correct": false }
            ],
            "explanation": { "en": "'De nada' is the standard reply to 'gracias' — but literally it's 'of nothing', so it can also mean 'you're kidding'." }
          },
          {
            "type": "fill",
            "prompt": "___ , ¿cómo estás?",
            "promptLang": "es",
            "answer": "hola",
            "accept": ["hola!"],
            "explanation": { "en": "'Hola' works at any hour of the day." }
          },
          {
            "type": "fill",
            "prompt": "Gracias. ___ nada.",
            "promptLang": "es",
            "answer": "de",
            "explanation": { "en": "'De nada' — 'you're welcome'." }
          },
          {
            "type": "choice",
            "prompt": "Which phrase means 'good night'?",
            "promptLang": "en",
            "options": [
              { "value": "buenas tardes", "correct": false },
              { "value": "buenas noches", "correct": true },
              { "value": "buenos días", "correct": false },
              { "value": "por favor", "correct": false }
            ]
          }
        ]
      }
    },

    {
      "id": "numeros",
      "order": 2,
      "title": "Números",
      "subtitle": "Counting from cero to cien",
      "sections": [
        {
          "type": "numbers",
          "title": "Cero a veinte",
          "note": "The five hardest: cinco, seis, siete, ocho, nueve. Drill these.",
          "wordIds": ["cero", "uno", "dos", "tres", "cuatro", "cinco", "seis", "siete", "ocho", "nueve", "diez", "once", "doce", "trece", "catorce", "quince", "dieciseis", "diecisiete", "dieciocho", "diecinueve", "veinte"]
        },
        {
          "type": "numbers",
          "title": "Tens and one hundred",
          "note": "21-29 are veintiuno, veintidós, veintitrés... then it's just the word 'y' + number: treinta y uno.",
          "wordIds": ["treinta", "cuarenta", "cincuenta", "cien"]
        },
        {
          "type": "text",
          "title": "The 'y' rule",
          "body": "Between 31 and 99 Spanish inserts 'y' before the final digit:\n\ntreinta y uno (31)\ncuarenta y cinco (45)\nnoventa y nueve (99)\n\nBut for 16-29 it's a single word: dieciséis, veintidós. And note 'ciento' shortens before a noun: ciento veinte (120), ciento lápises."
        }
      ],
      "quiz": {
        "id": "numeros-quiz",
        "title": "Números quiz",
        "passThreshold": 0.8,
        "questions": [
          {
            "type": "fill",
            "prompt": "15 = ___",
            "answer": "quince"
          },
          {
            "type": "fill",
            "prompt": "21 = ___",
            "answer": "veintiuno",
            "accept": ["veintiún", "veintiuno", "veintiuna"]
          },
          {
            "type": "fill",
            "prompt": "45 = ___",
            "answer": "cuarenta y cinco",
            "accept": ["cuarenta y cinco", "cuarenta ycinco", "cuarentaicinco"]
          },
          {
            "type": "choice",
            "prompt": "Which is 'eleven'?",
            "promptLang": "en",
            "options": [
              { "value": "diez", "correct": false },
              { "value": "once", "correct": true },
              { "value": "doce", "correct": false },
              { "value": "ochenta", "correct": false }
            ]
          },
          {
            "type": "choice",
            "prompt": "Which number needs the word 'y'?",
            "promptLang": "en",
            "options": [
              { "value": "dieciséis", "correct": false },
              { "value": "veinticinco", "correct": false },
              { "value": "ochenta y tres", "correct": true },
              { "value": "cuarenta", "correct": false }
            ],
            "explanation": { "en": "Teens and 21-29 are single words; 31-99 use 'y' before the last digit." }
          }
        ]
      }
    },

    {
